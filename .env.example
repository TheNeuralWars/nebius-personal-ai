# Copy to .env and fill in, OR just use run_live.sh which loads the key
# from a secure file at runtime. NEVER commit a real .env.

# Nebius Token Factory (OpenAI-compatible) — https://tokenfactory.nebius.com/
NEBIUS_API_KEY=your_nebius_token_factory_key_here

# Optional overrides (defaults shown)
# HERMES_LLM_PROVIDER=nebius
# HERMES_LLM_MODEL=NousResearch/Hermes-4-405B
# HERMES_LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
